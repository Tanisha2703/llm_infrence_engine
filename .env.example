# Copy this file to `.env` (same folder) and fill in the values YOURSELF. `.env` is gitignored; this example file is safe to commit.
# Do not paste these values into any chat. The scripts read them from the environment; they are never printed or logged.

# --- Modal (GPU runs for Stage 7) -------------------------------------------------------------------------------------
# Create at https://modal.com/settings/tokens ("New Token"). The ID looks like ak-..., the secret like as-...
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional: which Modal workspace/profile to use if you have several (leave empty otherwise)
MODAL_PROFILE=

# --- Run settings (not secrets; defaults are fine) ----------------------------------------------------------------------
# GPU type for the benchmark functions. A10G or L4 is cheap; A100-40GB is the "datacenter" reference.
MINISERVE_GPU=A10G
# Hard spending guard for one benchmark session, in USD. The runner stops launching new GPU jobs once its own estimate reaches this.
MINISERVE_BUDGET_USD=10

# --- Hugging Face (NOT needed: the Qwen models and WikiText-2 are public) -----------------------------------------------
# Only fill this in if you later want gated models (e.g. Llama) or higher download rate limits.
HF_TOKEN=
